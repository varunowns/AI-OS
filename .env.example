# Copy this file to .env and fill in your values.

# Path to your Obsidian vault root. Use forward slashes even on Windows.
AI_OS_VAULT_PATH=V:/Obsidian

# Your Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-4-6
AI_OS_LLM_MODEL=claude-sonnet-4-6
