# Copy this file to .env and fill in your values.

# Path to your Obsidian vault ROOT — the folder that contains the actual
# markdown notes. If your vault lives at V:/Obsidian/Obsidian Vault, set
# that full path, NOT V:/Obsidian (that is the container folder and will
# route notes to the wrong top-level folders).
# Use forward slashes even on Windows.
NORDRUN_VAULT_PATH=V:/Obsidian/Obsidian Vault

# Your Anthropic API key — https://console.anthropic.com/
# Leave blank when using a proxy like 9router.
ANTHROPIC_API_KEY=

# Optional LLM proxy/base URL (e.g. 9router). When set, the Anthropic SDK
# targets this endpoint instead of the default api.anthropic.com.
# NORDRUN_LLM_BASE_URL=http://localhost:20128/v1

# API key for the proxy (used in place of ANTHROPIC_API_KEY when
# NORDRUN_LLM_BASE_URL is set).
# NORDRUN_LLM_API_KEY=

# Which model to call for plugin LLM tasks. Defaults to claude-sonnet-4-6.
NORDRUN_LLM_MODEL=claude-sonnet-4-6
